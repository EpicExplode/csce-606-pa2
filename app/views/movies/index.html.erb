<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table id="movies">
  <thead>
    <tr>
      <%= sort_header "title", "Title", @sort, @direction %>
      <%= sort_header "rating", "Rating", @sort, @direction %>
      <%= sort_header "release_date", "Release Date", @sort, @direction %>
      <th scope="col"><span class="visually-hidden">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr id="<%= dom_id movie %>">
        <td class="<%= sort_class "title", @sort, @direction %>"><%= movie.title %></td>
        <td class="<%= sort_class "rating", @sort, @direction %>"><%= movie.rating %></td>
        <td class="<%= sort_class "release_date", @sort, @direction %>"><%= movie.release_date&.strftime("%b %-d, %Y") %></td>
        <td><%= link_to "Show", movie %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3"><%= pluralize(@movies.size, "movie") %></td>
      <td><%= link_to "New movie", new_movie_path %></td>
    </tr>
  </tfoot>
</table>
